    },
    {
      "name": "06 - Offers",
      "item": [
        {
          "name": "Get All Offers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/offers", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "offers"] }
          }
        },
        {
          "name": "Create Offer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/offers", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "offers"] },
            "body": {
