            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/qr-codes", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "qr-codes"] }
          }
        },
        {
          "name": "Create QR Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/qr-codes", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "qr-codes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"tableNumber\": \"Table 12\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "08 - Public Menu Flow",
      "item": [
        {
          "name": "Scan QR Token (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/public/menu/{{qrToken}}", "host": ["{{baseUrl}}"], "path": ["public", "menu", "{{qrToken}}"] }
          }
        },
        {
          "name": "Get Public Menu By Slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/public/menu/restaurant/{{restaurantSlug}}", "host": ["{{baseUrl}}"], "path": ["public", "menu", "restaurant", "{{restaurantSlug}}"] }
          }
        }
      ]
    },
    {
      "name": "09 - Super Admin & Subscriptions",
      "item": [
        {
          "name": "Get Platform Stats (Super Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/super-admin/stats", "host": ["{{baseUrl}}"], "path": ["super-admin", "stats"] }
          }
        },
        {
          "name": "Update Restaurant Status (Super Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/super-admin/restaurants/{{restaurantId}}/status", "host": ["{{baseUrl}}"], "path": ["super-admin", "restaurants", "{{restaurantId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Activate Subscription (Super Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/subscriptions/restaurants/{{restaurantId}}/activate", "host": ["{{baseUrl}}"], "path": ["subscriptions", "restaurants", "{{restaurantId}}", "activate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"PROFESSIONAL\",\n  \"months\": 12,\n  \"paymentId\": \"pay_razorpay_12345\",\n  \"paymentGateway\": \"RAZORPAY\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/subscriptions/restaurants/{{restaurantId}}/cancel", "host": ["{{baseUrl}}"], "path": ["subscriptions", "restaurants", "{{restaurantId}}", "cancel"] }
