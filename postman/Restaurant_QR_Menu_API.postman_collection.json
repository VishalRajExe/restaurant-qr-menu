          }
        }
      ]
    },
    {
      "name": "05 - Menu Items",
      "item": [
        {
          "name": "Get All Menu Items",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "menu-items"] }
          }
        },
        {
          "name": "Create Menu Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "menu-items"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"name\": \"Crispy Spring Rolls\",\n  \"description\": \"Served with sweet chili sauce\",\n  \"price\": 7.99,\n  \"isAvailable\": true,\n  \"vegNonveg\": \"VEG\"\n}",
