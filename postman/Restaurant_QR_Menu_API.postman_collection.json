          }
        },
        {
          "name": "Delete Branch",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/branches/{{branchId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "branches", "{{branchId}}"] }
          }
        }
      ]
    },
    {
      "name": "04 - Categories",
      "item": [
