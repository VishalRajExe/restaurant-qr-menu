            "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}", "categories", "{{categoryId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gourmet Starters\",\n  \"displayOrder\": 1,\n  \"status\": \"ACTIVE\"\n}",
